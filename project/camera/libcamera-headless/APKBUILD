# Headless GPU-enabled camera development build for Platina.
pkgname=platina-libcamera
pkgver=0.7.1
pkgrel=31
pkgdesc="Headless libcamera with GPU/CPU software ISP for Platina"
url="https://libcamera.org/"
arch="aarch64"
license="LGPL-2.1-or-later AND GPL-2.0-or-later AND CC0-1.0"
depends="alsa-utils python3 py3-paho-mqtt v4l-utils platina-mesa-freedreno"
sonameprefix="platina-"
makedepends="platina-mesa-freedreno coreutils eudev-dev gnutls-dev libevent-dev libjpeg-turbo-dev libyuv libyuv-dev linux-headers meson py3-jinja2 py3-ply py3-yaml python3-dev yaml-dev"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$pkgver/libcamera-v$pkgver.tar.gz
 imx363.yaml
 0001-imx363-properties.patch
 0002-simple-manual-white-balance.patch
 0003-platina-full-field-gpu-scale.patch
 0004-overlap-gpu-statistics.patch
 0005-platina-gpu-profile-dmabuf.patch
 0006-platina-gpu-rotation-saturation.patch
 0011-simple-manual-exposure.patch
 0012-platina-gpu-zoom.patch
 platina_exposure.h
 platina_zoom.h
 capture.cpp
 serve.py
 camera_mqtt.py
 platina-camera.openrc
 preview.html
 configuration.yaml"
builddir="$srcdir/libcamera-v$pkgver"
options="!strip !check"
ldpath="/usr/lib/platina-camera/lib"

prepare() {
 default_prepare
 cp "$srcdir/platina_exposure.h" "$builddir/src/ipa/simple/algorithms/platina_exposure.h"
 cp "$srcdir/platina_zoom.h" "$builddir/src/libcamera/software_isp/platina_zoom.h"
}

build() {
 export LDFLAGS="$LDFLAGS -Wl,-rpath,/usr/lib/platina-camera/gpu/lib -Wl,-rpath,/usr/lib/platina-camera/gpu/lib/dri"
 export PKG_CONFIG_PATH=/usr/lib/platina-camera/gpu/lib/pkgconfig
 abuild-meson --prefix=/usr/lib/platina-camera \
  --bindir=/usr/lib/platina-camera/bin --libdir=/usr/lib/platina-camera/lib \
  --libexecdir=/usr/lib/platina-camera/libexec --datadir=/usr/lib/platina-camera/share \
  --includedir=/usr/lib/platina-camera/include \
  -Dpipelines=simple -Dipas=simple -Dsoftisp-gpu=enabled \
  -Dcam=enabled -Dcam-jpeg=enabled -Dcam-output-kms=disabled -Dcam-output-sdl2=disabled \
  -Dqcam=disabled -Dgstreamer=disabled -Dpycamera=disabled -Dlc-compliance=disabled \
  -Ddocumentation=disabled -Dapps-output-dng=disabled -Dlibdw=disabled -Dlibunwind=disabled \
  -Dtracing=disabled -Dv4l2=disabled -Dtest=false -Dwerror=false . output
 meson compile -C output -j 2
 $CXX -std=c++17 -O2 -pthread -Iinclude -Ioutput/include "$srcdir/capture.cpp" \
  -Loutput/src/libcamera -Loutput/src/libcamera/base \
  -Wl,-rpath,/usr/lib/platina-camera/lib -Wl,-rpath-link,output/src/libcamera/base \
  -Wl,-rpath-link,/usr/lib/platina-camera/gpu/lib -Wl,-rpath-link,/usr/lib/platina-camera/gpu/lib/dri \
  -lcamera -lcamera-base -ljpeg -lyuv -o output/platina-camera-capture
}

package() {
 DESTDIR="$pkgdir" meson install --no-rebuild -C output
 install -Dm755 output/platina-camera-capture "$pkgdir/usr/lib/platina-camera/bin/platina-camera-capture"
 install -Dm755 "$srcdir/serve.py" "$pkgdir/usr/lib/platina-camera/bin/serve.py"
 install -Dm644 "$srcdir/camera_mqtt.py" "$pkgdir/usr/lib/platina-camera/bin/camera_mqtt.py"
 install -Dm755 "$srcdir/platina-camera.openrc" "$pkgdir/etc/init.d/platina-camera"
 install -Dm644 "$srcdir/preview.html" "$pkgdir/usr/lib/platina-camera/bin/preview.html"
 install -Dm644 "$srcdir/configuration.yaml" "$pkgdir/usr/lib/platina-camera/share/libcamera/configuration.yaml"
 install -Dm644 "$srcdir/imx363.yaml" "$pkgdir/usr/lib/platina-camera/share/libcamera/ipa/simple/imx363.yaml"

}

