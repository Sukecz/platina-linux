maintainer="Sukecz <222629366+Sukecz@users.noreply.github.com>"
pkgname=firmware-xiaomi-platina
pkgver=2
pkgrel=5
pkgdesc="User-supplied Xiaomi Mi 8 Lite GPU, Wi-Fi and modem firmware"
url="https://github.com/Sukecz/platina-linux"
arch="aarch64"
license="proprietary"
options="!strip !check !archcheck !spdx !tracedeps pmb:cross-native"
makedepends="qca-swiss-army-knife python3"
source="
    a512_zap.elf
    gen-board-2.py
    firmware-xiaomi-platina-bdwlan.tar.gz
    firmware-xiaomi-platina-modem.tar.gz
"
builddir="$srcdir"

build() {
    ath10k-fwencoder --create \
        --features=wowlan,no-nwifi-decap-4addr-padding,allows-mesh-bcast,mgmt-tx-by-ref,non-bmi,single-chan-info-per-channel \
        --set-wmi-op-version=tlv --set-htt-op-version=tlv --set-fw-api=5
    python3 "$srcdir/gen-board-2.py" "$srcdir/bdwlan" "$srcdir/bdwlan/board-2.json"
    cd "$srcdir/bdwlan"
    ath10k-bdencoder -c board-2.json -o "$srcdir/board-2.bin"
}

package() {
    local wifi="$pkgdir/lib/firmware/ath10k/WCN3990/hw1.0"
    local platform="$pkgdir/lib/firmware/postmarketos"
    install -Dm644 "$srcdir/firmware-5.bin" "$wifi/firmware-5.bin"
    install -Dm644 "$srcdir/board-2.bin" "$wifi/board-2.bin"
    install -Dm644 "$srcdir/bdwlan/wlanmdsp.mbn" "$platform/wlanmdsp.mbn"
    install -Dm644 "$srcdir/a512_zap.elf" "$platform/a512_zap.mbn"
    install -dm755 "$platform"
    install -m644 "$srcdir/modem/mba.mbn" "$srcdir/modem/modem.mdt" \
        "$srcdir"/modem/modem.b* "$platform/"
}
