# Local experimental headless adaptation; see project docs/SOURCE-AUDIT.md.
maintainer="Platina local project <platina@example.invalid>"
pkgname=device-xiaomi-platina
pkgdesc="Xiaomi Mi 8 Lite - experimental headless server"
pkgver=5
pkgrel=31
url="https://github.com/macosmojave2-alt/postmarket-mi8lite-platina"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
    firmware-qcom-adreno-a530
    firmware-xiaomi-platina
    linux-firmware-qca
    linux-postmarketos-qcom-sdm660
    mkbootimg
    msm-firmware-loader
    postmarketos-base
    chrony-openrc
    pam-rundir
    avahi
    avahi-openrc
    networkmanager-openrc
    networkmanager-cli
    networkmanager-wifi
    wireless-regdb
    dbus-openrc
    postmarketos-usb-moded-openrc
    postmarketos-usb-moded-default-profile-developer
    tzdata
    soc-qcom-sdm660
    soc-qcom-sdm660-rproc
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="deviceinfo kernel-cmdline.conf modules-initfs disable-suspend.start gpu-firmware.files platina-networkmanager.conf platina-usb.nmconnection platina-usb-network.start platina-avahi.conf"
build() {
    devicepkg_build $startdir $pkgname
}
package() {
    devicepkg_package $startdir $pkgname
    install -Dm755 "$srcdir/disable-suspend.start" "$pkgdir/etc/local.d/disable-suspend.start"
    install -Dm644 "$srcdir/gpu-firmware.files" "$pkgdir/usr/share/mkinitfs/files/00-platina-gpu-firmware.files"
    install -Dm644 "$srcdir/platina-networkmanager.conf" "$pkgdir/etc/NetworkManager/conf.d/30-platina-wifi.conf"
    install -Dm600 "$srcdir/platina-usb.nmconnection" "$pkgdir/etc/NetworkManager/system-connections/platina-usb.nmconnection"
    install -Dm755 "$srcdir/platina-usb-network.start" "$pkgdir/etc/local.d/platina-usb-network.start"
    install -Dm644 "$srcdir/platina-avahi.conf" "$pkgdir/usr/share/platina/avahi-daemon.conf"
}
