From: pmOS Mi8Lite <macosmojave2@gmail.com>
Subject: [PATCH] arm64: dts: qcom: sdm660-xiaomi-platina: enable display + synaptics TCM touch

Enable the display pipeline + BOE TD4320 panel (1080x2280) via panel-simple,
WLED (2 strings), model the LCDB VSP/VSN as fixed regulators, and enable the
Synaptics TouchComm (TCM) touchscreen, brought up independently of the panel so
it does not disturb the shared TDDI rails.

Also drop the platina removed_region@85800000 and cdsp-region@94e00000 reserved
memory nodes that overlap nodes already defined in sdm630.dtsi / are unreferenced.

Signed-off-by: pmOS Mi8Lite <macosmojave2@gmail.com>
--- a/arch/arm64/boot/dts/qcom/sdm660-xiaomi-platina.dts
+++ b/arch/arm64/boot/dts/qcom/sdm660-xiaomi-platina.dts
@@ -63,16 +63,6 @@
 			no-map;
 		};
 
-		cdsp-region@94e00000 {
-			reg = <0x00 0x94e00000 0x00 0x600000>;
-			no-map;
-		};
-
-		removed_region@85800000 {
-			reg = <0x00 0x85800000 0x00 0x3700000>;
-			no-map;
-		};
-
 		framebuffer_memory@9d400000 {
 			reg = <0x0 0x9d400000 0x0 (1080 * 2280 * 4)>;
 			no-map;
@@ -89,6 +79,31 @@
 		regulator-boot-on;
 	};
 
+	/*
+	 * The panel positive/negative supplies (VSP/VSN, +/-5.4V) are
+	 * generated by the PM660L LCDB block, for which there is no mainline
+	 * driver yet (see sdm660-mainline issue #125). The bootloader leaves
+	 * LCDB enabled at boot; model VSP/VSN as fixed always-on regulators so
+	 * the panel can probe and uses the voltages the bootloader set up.
+	 */
+	panel_vsp: panel-vsp-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vsp";
+		regulator-min-microvolt = <5400000>;
+		regulator-max-microvolt = <5400000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	panel_vsn: panel-vsn-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vsn";
+		regulator-min-microvolt = <5400000>;
+		regulator-max-microvolt = <5400000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
 	cam_avdd_front_vreg: cam-avdd-front-vreg {
 		compatible = "regulator-fixed";
 		regulator-name = "cam-avdd-front-vreg";
@@ -236,7 +251,12 @@
 };
 
 &adreno_gpu {
-	status = "disabled";
+	status = "okay";
+};
+
+&adreno_gpu_zap {
+	firmware-name = "a512_zap.mbn";
+	memory-region = <&zap_shader_region>;
 };
 
 &blsp_i2c2 {
@@ -252,14 +272,28 @@
 &blsp_i2c4 {
 	status = "okay";
 
-	touchscreen@1 {
-		compatible = "novatek,nt36672a-ts";
-		reg = <0x1>;
-		iovcc-supply = <&vreg_l11a_1p8>;
+	/*
+	 * Synaptics TouchComm (TCM) touchscreen. This unit has the Synaptics
+	 * variant (the stock kernel dmesg shows the Novatek and Focaltech
+	 * probes failing and the Synaptics controller at 4-0020 being present).
+	 * It speaks the TCM command/report protocol (not RMI4), driven by the
+	 * synaptics-tcm-i2c driver. It is integrated with the TD4320 TDDI
+	 * panel, so it follows the panel power state via panel=<&panel>.
+	 * vdd is the digital 1.8V rail; vbus is the panel analog rail (LCDB,
+	 * kept on by the bootloader). reset tlmm66, IRQ tlmm67.
+	 */
+	touchscreen@20 {
+		compatible = "syna,tcm-i2c";
+		reg = <0x20>;
+
+		vdd-supply = <&vreg_l11a_1p8>;
+
+
 		pinctrl-0 = <&ts_int_active &ts_rst_n>;
 		pinctrl-names = "default";
 		interrupts-extended = <&tlmm 67 IRQ_TYPE_EDGE_FALLING>;
 		reset-gpios = <&tlmm 66 GPIO_ACTIVE_LOW>;
+
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <2280>;
 	};
@@ -270,11 +304,11 @@
 };
 
 &gpucc {
-	status = "disabled";
+	status = "okay";
 };
 
 &mmcc {
-	status = "disabled";
+	status = "okay";
 };
 
 &pm660_gpios {
@@ -789,3 +823,67 @@
 	dr_mode = "peripheral";
 	extcon = <&extcon_usb>;
 };
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	vdd-supply = <&vreg_l1b_0p925>;
+	vdda-supply = <&vreg_l1a_1p225>;
+
+	panel: panel@0 {
+		compatible = "xiaomi,platina-td4320", "boe,td4320";
+		reg = <0>;
+
+		iovcc-supply = <&vreg_l11a_1p8>;
+		vsp-supply = <&panel_vsp>;
+		vsn-supply = <&panel_vsn>;
+
+		reset-gpios = <&tlmm 53 GPIO_ACTIVE_LOW>;
+
+		backlight = <&pm660l_wled>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&panel_reset_n &mdp_vsync_n>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vcca-supply = <&vreg_l1b_0p925>;
+	status = "okay";
+};
+
+&mmss_smmu {
+	status = "okay";
+};
+
+&pm660l_wled {
+	qcom,switching-freq = <800>;
+	qcom,current-limit-microamp = <20000>;
+	qcom,num-strings = <2>;
+
+	status = "okay";
+};
+
+/* Audio DAI links are wired up in 0018-platina-audio (internal sndcard);
+ * q6asm-dai provides the MultiMedia frontends, so enable it. */
+&q6asmdai {
+	status = "okay";
+};
