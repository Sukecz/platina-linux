 /* ---- probe ---- */
 
+static void syna_release_regulator(void *data)
+{
+	struct syna_tcm *ts = data;
+
+	/* Balance this consumer's enable on probe failure or driver removal.
+	 * Normal panel stop still leaves the shared rail enabled.
+	 */
+	if (ts->powered) {
+		regulator_disable(ts->vdd);
+		ts->powered = false;
+	}
+}
