From: Platina local project
Subject: [PATCH] drm/panel: integrate Platina Tianma NT36672A power and init

Hardware candidate; full boot and repeated power cycles await physical testing.
Stock evidence: project/display/tianma-reference.json.

--- a/drivers/gpu/drm/panel/panel-novatek-nt36672a.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36672a.c
@@ -50,6 +50,7 @@
 	unsigned long mode_flags;
 	enum mipi_dsi_pixel_format format;
 	unsigned int lanes;
+	bool reset_pulse;
 
 	void (*send_init_cmds)(struct mipi_dsi_multi_context *dsi_ctx);
 	void (*send_deinit_cmds)(struct mipi_dsi_multi_context *dsi_ctx);
@@ -117,6 +118,17 @@
 	ret = regulator_bulk_enable(ARRAY_SIZE(pinfo->supplies), pinfo->supplies);
 	if (ret < 0)
 		return ret;
+
+	if (pinfo->desc->reset_pulse) {
+		/* Platina downstream: physical high 1ms, low 1ms, high 10ms. */
+		gpiod_set_value(pinfo->reset_gpio, 0);
+		usleep_range(1000, 2000);
+		gpiod_set_value(pinfo->reset_gpio, 1);
+		usleep_range(1000, 2000);
+		gpiod_set_value(pinfo->reset_gpio, 0);
+		msleep(10);
+		return 0;
+	}
 
 	/*
 	 * As per downstream kernel, Reset sequence of Tianma FHD panel requires the panel to
@@ -138,13 +150,15 @@
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->link };
 
 	dsi_ctx.accum_err = nt36672a_panel_power_on(pinfo);
+	if (dsi_ctx.accum_err < 0)
+		return dsi_ctx.accum_err;
 
 	/* send init cmds */
 	if (pinfo->desc->send_init_cmds)
 		pinfo->desc->send_init_cmds(&dsi_ctx);
 
 	if (dsi_ctx.accum_err < 0)
-		gpiod_set_value(pinfo->reset_gpio, 0);
+		nt36672a_panel_power_off(panel);
 
 	return dsi_ctx.accum_err;
 }
@@ -912,7 +926,9 @@
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "failed to get regulators\n");
 
-	pinfo->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	pinfo->reset_gpio = devm_gpiod_get(dev, "reset",
+					   pinfo->desc->reset_pulse ?
+					   GPIOD_OUT_HIGH : GPIOD_OUT_LOW);
 	if (IS_ERR(pinfo->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(pinfo->reset_gpio),
 				     "failed to get reset gpio from DT\n");
@@ -974,7 +990,235 @@
 	drm_panel_remove(&pinfo->base);
 }
 
